// Coins was an Int (prism/save/0001.json); it becomes a Float. The old field keeps its saved name, printed by
// `prism-verse names`, and old saves go through MoneyToFloat once.

datasource {
  kind = "memory"
}

generator {
  prefix = "wallet_save"
}

model Wallet {
  Version     Int   = 1 @version
  LegacyCoins Int   @map("l") @deprecated
  Coins       Float @min(0.0)

  @@migrate(2, MoneyToFloat)
}
