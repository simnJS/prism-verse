// The SellThings player save, as the game uses it. To copy it into the game: kind = "player", using = ["Balance"].

datasource {
  kind = "memory"
}

generator {
  prefix = "demo_save"
  using  = ["prism_demo_constants"]
}

model PlayerState {
  Version         Int   = 1           @version
  Coins           Float               @initial(StartCoins) @min(0.0)
  CrateCount      Int                 @min(0)
  CrateValue      Float               @min(0.0)
  LuckLevel       Int                 @min(0)
  PedestalLevel   Int                 @min(0) @max(MaxPedestalLevel)
  RegenLevel      Int                 @min(0) @max(MaxRegenLevel)
  YieldLevel      Int                 @min(0) @max(MaxYieldLevel)
  AutoRollLevel   Int                 @min(0) @max(MaxAutoRollLevel)
  FurnaceLevel    Int                 @min(0) @max(MaxFurnaceLevel)
  AutoRollOn      Bool
  DroneCount      Int   = StartDrones @min(StartDrones) @max(MaxDrones)
  DroneSpeedLevel Int                 @min(0) @max(DroneMaxSpeedLevel)
  FuserBuilt      Bool
  BoostOres       Int[]               @valid(IsKnownOre, -1) @maxItems(MaxBoostPedestals) @initial([-1])
  Inventory       InventoryStack[]    @where(IsValidStack) @maxItems(HotbarOreSlots)
  Mines           PlacedMine[]        @where(IsKnownMine) @maxItems(MaxPlacedMines)
  NextMineId      Int   = 1           @counter(Mines.Id)
  UnlockedCells   Int[]               @maxItems(MaxPlotCells)
  OwnedPets       OwnedPet[]          @where(IsKnownPet) @maxItems(MaxStoredPets)
  NextPetUid      Int   = 1           @counter(OwnedPets.Uid)
  TutorialStep    Int                 @min(0) @max(TutorialSteps)
  LastSeen        Float               @lastSeen
  FirstSeen       Float               @firstSeen
  SaveCount       Int                 @saveCount

  Offers          Int[]               @transient @initial([-1])
  GemMultiplier   Float = 1.0         @transient
  GemEndsAt       Float               @transient
  HeldOre         Int   = -1          @transient
  OfflineEarned   Float               @transient
  SalesCount      Int                 @transient

  @@onLoad(AfterLoad)
}

type InventoryStack {
  OreId Int
  Count Int
}

type PlacedMine {
  Id       Int   @id
  OreId    Int
  X        Float
  Y        Float
  Turns    Int   @min(0) @max(3)
  Level    Int   @min(0) @max(MaxOreLevel)
  Mutation Int   @valid(IsKnownMutation)
}

type OwnedPet {
  Uid      Int  @id
  PetId    Int
  Fusion   Int  @min(0) @max(MaxPetFusion)
  Equipped Bool
}
