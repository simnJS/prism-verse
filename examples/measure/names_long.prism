// The persisted fields of the SellThings save with readable saved names, for the self-test's size measurement.
// Pad fills the rest of the player map: the longest Pad that fits gives the size of the other fields.

datasource {
  kind = "memory"
}

generator {
  prefix = "names_long"
  names  = "long"
}

model NamesLong {
  Version         Int   = 1 @version
  Coins           Float
  CrateCount      Int
  CrateValue      Float
  LuckLevel       Int
  PedestalLevel   Int
  RegenLevel      Int
  YieldLevel      Int
  AutoRollLevel   Int
  FurnaceLevel    Int
  AutoRollOn      Bool
  DroneCount      Int   = 1
  DroneSpeedLevel Int
  FuserBuilt      Bool
  BoostOres       Int[]           @maxItems(8)
  Inventory       LongStack[]     @maxItems(32)
  Mines           LongMine[]      @maxItems(1000)
  NextMineId      Int   = 1
  UnlockedCells   Int[]           @maxItems(64)
  OwnedPets       LongPet[]       @maxItems(200)
  NextPetUid      Int   = 1
  TutorialStep    Int
  LastSeen        Float           @lastSeen
  FirstSeen       Float           @firstSeen
  SaveCount       Int             @saveCount
  Pad             String
}

type LongStack {
  OreId Int
  Count Int
}

type LongMine {
  Id       Int @id
  OreId    Int
  X        Float
  Y        Float
  Turns    Int
  Level    Int
  Mutation Int
}

type LongPet {
  Uid      Int @id
  PetId    Int
  Fusion   Int
  Equipped Bool
}
